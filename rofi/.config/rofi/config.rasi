/* =============================================================================
 * ROFI CONFIGURATION: ROYAL SHEIKAH
 * ============================================================================= */

configuration {
    /* Ancient tablet initialization prompt */
    display-drun: "◈ RUNE.INIT:";
    show-icons: true;
    /* Keeping your icon theme, though you might want a flatter one later */
    icon-theme: "candy-icons";
    drun-display-format: "{name}";
    font: "JetBrainsMono Nerd Font 12";
    hover-select: true;
    me-select-entry: "";
    me-accept-entry: "MousePrimary";
}

/* --- Royal Sheikah Palette & Global Reset --- */
* {
    obsidian: rgba(28, 28, 30, 0.95); /* Deep slate with slight transparency */
    obsidian-solid: #1c1c1e;          /* Solid dark for contrast on selected items */
    surface: rgba(36, 36, 38, 0.95);  /* Slightly elevated rock for the input bar */
    rock: #4e544b;
    stone: #c0c6ba;                   /* Default text color */
    muted: #788074;
    sheikah: #00e5ff;                 /* Cyan energy */
    royal: #d4af37;                   /* Triforce Gold */

    background-color: transparent;
    text-color: @stone;
}

/* --- Main Window --- */
window {
    background-color: @obsidian;
    border: 2px;
    border-color: @sheikah;
    border-radius: 12px;
    padding: 20px;
    width: 40%;
}

mainbox {
    spacing: 15px;
}

/* --- Search Bar (Elevated Surface) --- */
inputbar {
    background-color: @surface;
    border: 1px;
    border-color: @royal;
    border-radius: 8px;
    padding: 12px;
    children: [prompt, entry];
}

prompt {
    text-color: @sheikah;
    font: "JetBrainsMono Nerd Font Bold 11";
}

entry {
    placeholder: "Search the compendium...";
    placeholder-color: @muted;
    padding: 0 0 0 10px;
    text-color: @royal;
}

/* --- Application List --- */
listview {
    lines: 8;
    columns: 1;
    scrollbar: false;
    spacing: 5px;
    border: 0px;
}

element {
    padding: 10px;
    border-radius: 6px;
}

element-icon {
    size: 24px;
    margin: 0 15px 0 0;
}

/* Ensure text inherits the color from the selected state */
element-text {
    vertical-align: 0.5;
    text-color: inherit;
    background-color: inherit;
}

element normal.normal, element alternate.normal {
    background-color: transparent;
    text-color: @stone;
}

/* --- Active Selection --- */
element selected.normal {
    background-color: @royal;
    text-color: @obsidian-solid;
    border: 1px;
    border-color: @sheikah;
}
