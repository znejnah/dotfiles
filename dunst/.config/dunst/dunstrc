# ==============================================================================
# DUNST CONFIGURATION: VICE CITY / LEONIDA (ABYSSAL NIGHT)
# ==============================================================================

[global]
# --- Display & Geometry ---
monitor = 0
follow = mouse
# Width x Height + Offset_X + Offset_Y
width = 320
height = 300
origin = top-right
# Leaves a gap below the Waybar (assuming Waybar height is ~38 + 8 margin)
offset = 12x56
scale = 0
notification_limit = 5

# --- Progress Bar ---
progress_bar = true
progress_bar_height = 8
progress_bar_frame_width = 1
progress_bar_min_width = 150
progress_bar_max_width = 300

# --- Spacing & Padding ---
padding = 12
horizontal_padding = 16
text_icon_padding = 12
gap_size = 8

# --- Borders & Appearance ---
frame_width = 2
separator_height = 2
separator_color = frame
sort = yes
idle_threshold = 120

# Matches the Waybar HUD island border radius
corner_radius = 8

# --- Typography ---
font = JetBrainsMono Nerd Font 10
line_height = 0
markup = full
# Bold Sunset Pink title, standard Soft Vapor body
format = "<b><span foreground='#ff5ca8'>%s</span></b>\n%b"
alignment = left
vertical_alignment = center
show_age_threshold = 60
word_wrap = yes

# --- Backend & Behavior ---
browser = /usr/bin/xdg-open
always_run_script = true
title = Dunst
class = Dunst
ignore_dbusclose = false
force_xwayland = false
force_xinerama = false
mouse_left_click = close_current
mouse_middle_click = do_action, close_current
mouse_right_click = close_all

# ==============================================================================
# URGENCY LEVELS & PALETTE
# ==============================================================================
# Abyssal Night Base: #07091b (with ~92% opacity -> #07091beb)
# Deep Bay Surface: #0f1436
# Text: #d5ddf7 (Soft Vapor)

[urgency_low]
# Neon Purple for passive / low-priority notifications
background = "#07091beb"
foreground = "#8b96c2"
frame_color = "#8c6cff"
highlight = "#00f0ff"
timeout = 4

[urgency_normal]
# Sunset Pink frame with Vice Cyan progress highlight for standard notifications
background = "#07091bf2"
foreground = "#d5ddf7"
frame_color = "#ff5ca8"
highlight = "#00f0ff"
timeout = 6

[urgency_critical]
# Coral Heat frame with Miami Peach highlight on Deep Bay surface
# Timeout 0 means it will stay on screen until manually clicked
background = "#0f1436f7"
foreground = "#d5ddf7"
frame_color = "#ff3b6b"
highlight = "#ffb86b"
timeout = 0
