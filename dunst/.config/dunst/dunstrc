# ==============================================================================
# DUNST CONFIGURATION: VICE
# ==============================================================================

[global]
# --- Display & Geometry ---
monitor = 0
follow = mouse
# Width x Height + Offset_X + Offset_Y
width = 320
height = 300
origin = top-right
# Leaves a gap below the Waybar (assuming Waybar height is ~38 + 8 margin)
offset = 12x56
scale = 0
notification_limit = 5

# --- Progress Bar ---
progress_bar = true
progress_bar_height = 8
progress_bar_frame_width = 1
progress_bar_min_width = 150
progress_bar_max_width = 300

# --- Spacing & Padding ---
padding = 12
horizontal_padding = 16
text_icon_padding = 12
gap_size = 8

# --- Borders & Appearance ---
frame_width = 2
separator_height = 2
separator_color = frame
sort = yes
idle_threshold = 120

# Matches the Waybar and Kitty border radius
corner_radius = 8

# --- Typography ---
font = JetBrainsMono Nerd Font 10
line_height = 0
markup = full
# Bold Flamingo title, standard Vapor Mist body
format = "<b><span foreground='#ff2a85'>%s</span></b>\n%b"
alignment = left
vertical_alignment = center
show_age_threshold = 60
word_wrap = yes

# --- Backend & Behavior ---
browser = /usr/bin/xdg-open
always_run_script = true
title = Dunst
class = Dunst
ignore_dbusclose = false
force_xwayland = false
force_xinerama = false
mouse_left_click = close_current
mouse_middle_click = do_action, close_current
mouse_right_click = close_all

# ==============================================================================
# URGENCY LEVELS & PALETTE
# ==============================================================================
# Vice Midnight Base: #130f1d (with ~90% opacity -> #130f1de6)
# Text: #e8e0f5 (Vapor Mist)

[urgency_low]
# Ocean Drive Cyan for minor info (e.g., media player tracks)
background = "#130f1de6"
foreground = "#e8e0f5"
frame_color = "#00f0ff"
highlight = "#00f0ff"
timeout = 4

[urgency_normal]
# Flamingo Neon for standard notifications
background = "#130f1de6"
foreground = "#e8e0f5"
frame_color = "#ff2a85"
highlight = "#00f0ff"
timeout = 6

[urgency_critical]
# Heatwave Crimson for critical system states (e.g., low battery, errors)
# Timeout 0 means it will stay on screen until manually clicked
background = "#130f1df2"
foreground = "#ffffff"
frame_color = "#ff1744"
highlight = "#ff1744"
timeout = 0
