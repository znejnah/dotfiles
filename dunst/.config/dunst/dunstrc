[global]
  monitor = 0
  follow = mouse
  width = 300
  height = 300
  origin = top-right
  offset = 20x20
  padding = 16
  horizontal_padding = 16
  frame_width = 2
  frame_color = "#8800ff"
  separator_color = frame_color
  font = JetBrainsMono Nerd Font 10
  format = "<b>%s</b>\n%b"
  corner_radius = 8
  background = "#101010"
  foreground = "#ffffff"
  timeout = 5

[urgency-low]
  frame_color = "#00e5ff"
  timeout = 3

[urgency-normal]
  frame_color = "#8800ff"
  timeout = 5


[urgency-critical]
  frame_color = "#ff003c"
  timeout = 0
