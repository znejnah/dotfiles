{
  "layer": "top",
  "position": "top",
  "height": 38,
  "spacing": 0,
  "exclusive": true,
  "margin-top": 8,
  "margin-left": 12,
  "margin-right": 12,

  "modules-left": ["hyprland/workspaces", "hyprland/window"],
  "modules-center": ["clock"],
  "modules-right": ["network", "cpu", "temperature", "memory", "pulseaudio", "bluetooth", "tray"],

  "hyprland/workspaces": {
    "format": "{icon}",
    "format-icons": {
      "active": " ◈ ",
      "default": " ◇ ",
      "urgent": " ⎔ ",
    },
    "persistent-workspaces": {
      "*": 4,
    },
  },

  "hyprland/window": {
    "format": "{class}:::{title}",
    "max-length": 45,
    "rewrite": {
      "firefox:::(.*)": "󰈹  $1",
      "dev.zed.Zed:::(.*)": "  $1",
      "kitty:::(.*)": "  $1",
      "^(?!(firefox|dev\\.zed\\.Zed|kitty))([^:]*):::(.*)": "⟁ $1",
    },
    "separate-outputs": true,
  },

  "clock": {
    "timezone": "Europe/Paris",
    "format": " {:%I:%M <span color='#00e5ff' size='small'><b>%p</b></span>}",
    "format-alt": "󰃭 {:%a %d %b}",
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
    "calendar": {
      "mode": "month",
      "mode-mon-col": 3,
      "weeks-pos": "left",
      "on-scroll": 1,
      "format": {
        "months": "<span color='#d4af37'><b>{}</b></span>",
        "days": "<span color='#c0c6ba'>{}</span>",
        "weeks": "<span color='#4e544b'>W{}</span>",
        "weekdays": "<span color='#00e5ff'><b>{}</b></span>",
        "today": "<span color='#1c1c1e' background='#d4af37'><b> {} </b></span>",
      },
    },
    "actions": {
      "on-click-right": "mode",
      "on-scroll-up": "shift_up",
      "on-scroll-down": "shift_down",
    },
  },

  "network": {
    "format-wifi": "  {bandwidthDownBytes} ↓ {bandwidthUpBytes} ↑",
    "format-ethernet": "󰈀  {bandwidthDownBytes} ↓ {bandwidthUpBytes} ↑",
    "format-disconnected": "󰪎  Offline",
    "tooltip-format": "{ifname}: {ipaddr}/{cidr}",
    "interval": 2,
  },

  "cpu": {
    "format": "  {usage}%",
    "interval": 2,
    "states": {
      "warning": 70,
      "critical": 90,
    },
  },

  "temperature": {
    "hwmon-path-abs": "/sys/devices/pci0000:00/0000:00:18.3/hwmon",
    "input-filename": "temp1_input",
    "critical-threshold": 80,
    "format": " {temperatureC}°C",
    "format-critical": "󰈸 {temperatureC}°C",
    "interval": 2,
    "tooltip": false,
  },

  "memory": {
    "format": "  {}%",
    "interval": 2,
    "states": {
      "warning": 75,
      "critical": 90,
    },
  },

  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "󰖁 Muted",
    "format-icons": {
      "default": ["󰕿", "󰖀", "󰕾"],
    },
    "on-click": "kitty --class audio-tui -e wiremix",
  },

  "bluetooth": {
    "format": "󰂯",
    "format-disabled": "󰂲",
    "format-connected": "󰂱 {num_connections}",
    "tooltip-format": "{controller_alias}\t{status}\n{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias} ({device_battery_percentage}%)",
    "on-click": "kitty --class bluetooth-tui -e bluetui",
  },

  "tray": {
    "icon-size": 16,
    "spacing": 10,
  },
}
