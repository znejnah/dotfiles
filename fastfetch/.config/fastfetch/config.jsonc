{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "small",
    "color": {
      "1": "#00e5ff",
      "2": "#d4af37"
    },
    "padding": {
      "top": 1,
      "left": 1,
      "right": 3
    }
  },
  "display": {
    "separator": " ❯ ",
    "color": {
      "keys": "#d4af37",
      "title": "#00e5ff",
      "separator": "#4e544b"
    }
  },
  "modules": [
    "title",
    {
      "type": "custom",
      "format": "──────────────────────────────"
    },
    {
      "type": "os",
      "key": " OS"
    },
    {
      "type": "kernel",
      "key": " Kernel"
    },
    {
      "type": "packages",
      "key": "󰏖 Packages"
    },
    {
      "type": "wm",
      "key": " WM"
    },
    {
      "type": "terminal",
      "key": " Terminal"
    },
    {
      "type": "cpu",
      "key": " CPU",
      "format": "{name} ({cores-logical}c)"
    },
    {
      "type": "gpu",
      "key": "󰢮 GPU",
      "format": "{name}"
    },
    {
      "type": "memory",
      "key": " Memory"
    },
    {
      "type": "disk",
      "key": " Disk",
      "folders": "/"
    },
    {
      "type": "uptime",
      "key": " Uptime"
    }
  ]
}
