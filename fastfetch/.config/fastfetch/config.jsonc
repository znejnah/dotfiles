{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "small",
    "color": {
      "1": "#8c6cff",
      "2": "#8c6cff"
    },
    "padding": {
      "top": 1,
      "left": 1,
      "right": 3
    }
  },
  "display": {
    "separator": " ❯ ",
    "color": {
      "keys": "#8c6cff",
      "title": "#00f0ff",
      "output": "#d5ddf7",
      "separator": "#ff5ca8"
    }
  },
  "modules": [
    "title",
    {
      "type": "custom",
      "format": "\u001b[38;2;140;108;255m──────────────────────────────\u001b[0m"
    },
    {
      "type": "os",
      "key": " OS"
    },
    {
      "type": "kernel",
      "key": " Kernel"
    },
    {
      "type": "packages",
      "key": "󰏖 Packages"
    },
    {
      "type": "terminal",
      "key": " Terminal"
    },
    {
      "type": "wm",
      "key": " WM"
    },
    {
      "type": "cpu",
      "key": " CPU",
      "format": "{name} ({cores-logical}c)"
    },
    {
      "type": "gpu",
      "key": "󰢮 GPU",
      "format": "{name}"
    },
    {
      "type": "memory",
      "key": " RAM"
    },
    {
      "type": "disk",
      "key": " Disk",
      "folders": "/"
    },
    {
      "type": "uptime",
      "key": " Uptime"
    }
  ]
}
