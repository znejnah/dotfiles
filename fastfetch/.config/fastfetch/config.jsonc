{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "small",
    "color": {
      "1": "#ff2a85",
      "2": "#ff2a85",
    },
    "padding": {
      "top": 1,
      "left": 1,
      "right": 3,
    },
  },
  "display": {
    "separator": " ❯ ",
    "color": {
      "keys": "#ff2a85",
      "title": "#00f0ff",
      "separator": "#3b2d54",
    },
  },
  "modules": [
    "title",
    {
      "type": "custom",
      "format": "──────────────────────────────",
    },
    {
      "type": "os",
      "key": " OS",
    },
    {
      "type": "kernel",
      "key": " Kernel",
    },
    {
      "type": "packages",
      "key": "󰏖 Packages",
    },
    {
      "type": "wm",
      "key": " WM",
    },
    {
      "type": "terminal",
      "key": " Terminal",
    },
    {
      "type": "cpu",
      "key": " CPU",
      "format": "{name} ({cores-logical}c)",
    },
    {
      "type": "gpu",
      "key": "󰢮 GPU",
      "format": "{name}",
    },
    {
      "type": "memory",
      "key": " Memory",
    },
    {
      "type": "disk",
      "key": " Disk",
      "folders": "/",
    },
    {
      "type": "uptime",
      "key": " Uptime",
    },
  ],
}
