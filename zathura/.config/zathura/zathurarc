set statusbar-fg "#ff2a85"
set inputbar-bg "#130f1d"
set inputbar-fg "#00f0ff"
set highlight-color "#ff2a85"
set highlight-active-color "#00f0ff"
set completion-highlight-bg "#00f0ff"
set completion-highlight-fg "#130f1d"
